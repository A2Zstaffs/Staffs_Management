# A2ZStaffs VMS Backend Environment Variables
# Copy this file to .env and update the values

# Server Configuration
NODE_ENV=staging
PORT=5001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# MongoDB Configuration
# For local MongoDB instance
MONGODB_URI=mongodb+srv://sandeep:sandeep123@cluster1.alp9lh5.mongodb.net/?retryWrites=true&w=majority&appName=Cluster1

# Alternative MongoDB Atlas connection (uncomment and update if using MongoDB Atlas)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/a2zstaffs_vms?retryWrites=true&w=majority

# Database Name
DB_NAME=a2zstaffs_vms

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRE=30d

# Email Configuration (if needed for future features)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads