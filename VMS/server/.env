# A2ZStaffs VMS Backend Environment Variables
# Copy this file to .env and update the values

# Server Configuration
NODE_ENV=staging
PORT=5001

#AWS 
AWS_ACCESS_KEY_ID=xxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxx
AWS_REGION=eu-xxxxx-1
AWS_BUCKET_NAME=a2zstaffsresume

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# MongoDB Configuration
# For local MongoDB instance
MONGODB_URI=mongodb+srv://xxxxxxx:xxxxxx@cluster1.alp9lh5.mongodb.net/?retryWrites=true&w=majority&appName=Cluster1

# Alternative MongoDB Atlas connection (uncomment and update if using MongoDB Atlas)
# MONGODB_URI=xxxxx

# Database Name
DB_NAME=a2zstaffs_vms

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRE=30d

MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
